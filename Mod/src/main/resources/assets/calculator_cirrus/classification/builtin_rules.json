{
  "version": 2,
  "comment": "Built-in recipe classification rules derived from analysis of 15 modpack exports (2026-08), tightened by a 4203-plan multi-pack routing audit (14 packs x 3 complexity tiers, 2026-08-22): quest-reward / villager-trade / JER-display JEI categories were being executed as production steps. Extended by chain-review round 1 (21 packs x batch-001/002, 2026-08-29): anvil/enchantment id leaks, storage compression ladders, quark slab_to_block tag explosion, chipped/chisel stonecutting substrate, laser_drill. Patterns must survive the test-mod mimic namespace, where 'jei:category/x' becomes 'cirrus_test:jei__category/x' — hence the '(jei:|jei__)category/' form instead of a '^jei:' anchor. Exclusion tags (quality/junk, quality/duplicate) remove recipes from routing via the default source policy; advisory tags (pattern/*, intent/*) only influence scoring/topology. Keep exclusion rules conservative.",
  "rules": [
    {
      "id": "cirrus:quests",
      "systemPattern": "(?i)(jei:|jei__)category/(ftbquests|quests?)/",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:archaeology",
      "systemPattern": "(?i)(jearchaeology|/archaeology|archeolog)",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:query_displays",
      "systemPattern": "(?i)(attachment_query|/query$)",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:trades",
      "systemPattern": "(?i)(queen_trades|queen_color_randomizer_trades|amadron_trade|spirit_trade|villager_trades|/trades$|farmingforblockheads/market)",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:villager_trade_displays",
      "systemPattern": "(?i)(jei:|jei__)category/[^/]+/(potential_)?villager(_trade)?s?$",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:jeresources_displays",
      "systemPattern": "(?i)(jei:|jei__)category/[^/]+/(plant|mob|fluid|dungeon|ore)$",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:market_npc_trades",
      "systemPattern": "(?i)(jei:|jei__)category/[^/]+/(amadron(/spirit_trade)?|spirit_trade)$",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:machine_produce_displays",
      "systemPattern": "(?i)(jei:|jei__)category/industrialforegoing/machine_produce$",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:synthetic_anvil_duplicates",
      "systemPattern": "(?i)(jei:|jei__)category/minecraft/anvil$",
      "recipePathPattern": "(?i)enchantment\\._\\d+",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:breeding_displays",
      "systemPattern": "(?i)^jei:category/(easy_villagers|justenoughbreeding)/",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:loot_displays",
      "systemPattern": "(?i)(hostilenetworks/(loot_fabricator|sim_chamber)|/loot_(table|fabricator)|locate_structure)",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:colony_views",
      "systemPattern": "(?i)^jei:category/minecolonies/",
      "tags": ["cirrus:quality/duplicate"]
    },
    {
      "id": "cirrus:jei_vanilla_mirrors",
      "systemPattern": "^jei:category/minecraft/(crafting|smelting|blasting|smoking|campfire_cooking|stonecutting|smithing|brewing)$",
      "tags": ["cirrus:quality/duplicate"]
    },
    {
      "id": "cirrus:recolor_systems",
      "systemPattern": "(?i)(/coloring$|/painting$|/dyer$)",
      "tags": ["cirrus:pattern/recolor"]
    },
    {
      "id": "cirrus:recolor_recipes",
      "recipePathPattern": "(?i)(redying|recolor)",
      "tags": ["cirrus:pattern/recolor"]
    },
    {
      "id": "cirrus:chisel_systems",
      "systemPattern": "(?i)(/chiseling$|^jei:category/chipped/|/mystery_conversion$)",
      "tags": ["cirrus:pattern/exchange"]
    },
    {
      "id": "cirrus:reinforced_swaps",
      "systemPattern": "(?i)securitycraft/(vanilla_to_securitycraft|securitycraft_to_vanilla)",
      "tags": ["cirrus:pattern/exchange"]
    },
    {
      "id": "cirrus:recycling_recipes",
      "recipePathPattern": "(?i)(^|/|_)(recycling|recycle|salvage|salvaging|disassembly|disassembling|uncrafting|uncraft)(/|_|$)",
      "tags": ["cirrus:intent/recycling"]
    },
    {
      "id": "cirrus:recycling_systems",
      "systemPattern": "(?i)(/salvaging$|/scrapping$|/disassembly)",
      "tags": ["cirrus:intent/recycling"]
    },
    {
      "id": "cirrus:mass_valorization",
      "systemPattern": "(?i)(composter|composting|nutritional_liquifier|canning_machine)",
      "tags": ["cirrus:intent/recycling"]
    },
    {
      "id": "cirrus:resource_generators",
      "systemPattern": "(?i)(blockgen|cobblegen|laser_ore|laser_drill|ore_to_resource|/quarry|oil_drilling|pollination|/fruiting$|botanypots/crop|alakarkinos|graphite_processing)",
      "tags": ["cirrus:intent/generation"]
    },
    {
      "id": "cirrus:living_matter_predictions",
      "recipePathPattern": "(?i)((^|/|_)living_?matter(/|_|$)|_prediction$|/predictions?/)",
      "tags": ["cirrus:intent/recycling"]
    },
    {
      "id": "cirrus:giant_block_conversions",
      "recipePathPattern": "(?i)(^|/)giant_\\w+_to_",
      "tags": ["cirrus:pattern/exchange"]
    },
    {
      "id": "cirrus:anvil_leak_recipes",
      "recipeIdPattern": "(?i)(^minecraft:anvil\\.(self_repair|materials_repair)|^minecraft:enchantment\\.|^crafting_on_a_stick:anvil$|enchantment\\.lvl_\\d+)",
      "tags": ["cirrus:quality/junk"]
    },
    {
      "id": "cirrus:storage_compression_ladders",
      "recipeIdPattern": "(?i)(^allthecompressed:(compress|decompress)/|^quark:building/crafting/(compressed/|raw_[a-z_]+_bricks|[^/]*uncompress|vertslabs/|vertplanks/)|crateuncompress|_from_crate$|_from_bag$|^immersiveengineering:crafting/(ingot|nugget|storage)_steel_to_|^create:crafting/materials/cardboard_(block|from_block)$|^minecraft:(bone_block|bone_meal|lapis_block|lapis_lazuli|redstone_block|redstone|coal_block|coal|diamond_block|diamond|emerald_block|emerald|iron_block|gold_block|copper_block|netherite_block|honey_block|honey_bottle|hay_block|slime_block|slime_ball|magma_block|magma_cream|raw_iron_block|raw_iron|raw_gold_block|raw_gold|raw_copper_block|raw_copper)$|_from_(iron|gold|copper|diamond|emerald|netherite|lapis|redstone|coal|zinc|steel|bronze|ferricore|eclipsealloy|celestigem|blazegold)_block$|_nuggets?_from_[a-z_]+$|_[a-z_]+_from_nuggets?$|_(block_craft|block_decraft)$|^farmersdelight:(rice|straw|canvas)|_from_conversion$|^productivetrees:wood/|(blazing_crystal|dielectric_rod))",
      "tags": ["cirrus:pattern/storage_ladder"]
    },
    {
      "id": "cirrus:variant_stonecutting_cycles",
      "recipeIdPattern": "(?i)(createdeco|dndecor|garnished|blockbox|glazedresymmetry):",
      "recipePathPattern": "(?i)(stonecutting|shard|slab|pillar|centered)",
      "tags": ["cirrus:pattern/exchange"]
    },
    {
      "id": "cirrus:smithing_trim_swaps",
      "recipePathPattern": "(?i)_smithing_trim$",
      "tags": ["cirrus:pattern/exchange"]
    },
    {
      "id": "cirrus:slab_to_block_generalized",
      "recipeIdPattern": "(?i)quark:tweaks/crafting/slab_to_block",
      "tags": ["cirrus:pattern/exchange"]
    },
    {
      "id": "cirrus:chisel_stonecutting_variants",
      "recipeIdPattern": "(?i)stonecutting/(chipped|chisel)_",
      "tags": ["cirrus:pattern/exchange"]
    },
    {
      "id": "cirrus:salvage_mod_roundtrips",
      "mod": "create_salvage",
      "tags": ["cirrus:intent/recycling"]
    }
  ]
}
