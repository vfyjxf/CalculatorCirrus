{
  "version": 3,
  "rules": [
    {
      "id": "cirrus:quests",
      "label": "[feat+dispose] FTB Quests reward pages",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "contains",
        "values": [
          "category/ftbquests/",
          "category/quest"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/quests"
        },
        {
          "do": "tag",
          "tag": "cirrus:quality/junk"
        }
      ]
    },
    {
      "id": "cirrus:archaeology",
      "label": "[feat+dispose] Archaeology brush/display categories",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "contains",
        "values": [
          "archeolog",
          "jearchaeology",
          "/archaeology"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/archaeology"
        },
        {
          "do": "tag",
          "tag": "cirrus:quality/junk"
        }
      ]
    },
    {
      "id": "cirrus:query_displays",
      "label": "[feat+dispose] Attachment query / query display categories",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "any_of",
        "conditions": [
          {
            "kind": "system",
            "op": "contains",
            "values": [
              "attachment_query"
            ]
          },
          {
            "kind": "system",
            "op": "suffix",
            "values": [
              "/query"
            ]
          }
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/query_displays"
        },
        {
          "do": "tag",
          "tag": "cirrus:quality/junk"
        }
      ]
    },
    {
      "id": "cirrus:trades",
      "label": "[feat+dispose] Trade tables and market displays",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "any_of",
        "conditions": [
          {
            "kind": "system",
            "op": "contains",
            "values": [
              "queen_trades",
              "queen_color_randomizer_trades",
              "amadron_trade",
              "spirit_trade",
              "villager_trades",
              "farmingforblockheads/market"
            ]
          },
          {
            "kind": "system",
            "op": "suffix",
            "values": [
              "/trades"
            ]
          }
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/trades"
        },
        {
          "do": "tag",
          "tag": "cirrus:quality/junk"
        }
      ]
    },
    {
      "id": "cirrus:villager_trade_displays",
      "label": "[feat+dispose] JEI villager trade preview categories",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "regex",
        "values": [
          "category/[^/]+/(potential_)?villager(_trade)?s?$"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/villager_trade_displays"
        },
        {
          "do": "tag",
          "tag": "cirrus:quality/junk"
        }
      ]
    },
    {
      "id": "cirrus:jeresources_displays",
      "label": "[feat+dispose] JER plant/mob/fluid/dungeon/ore info pages",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "regex",
        "values": [
          "category/[^/]+/(plant|mob|fluid|dungeon|ore)$"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/jeresources_displays"
        },
        {
          "do": "tag",
          "tag": "cirrus:quality/junk"
        }
      ]
    },
    {
      "id": "cirrus:market_npc_trades",
      "label": "[feat+dispose] Amadron / spirit trade market displays",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "regex",
        "values": [
          "category/[^/]+/(amadron(/spirit_trade)?|spirit_trade)$"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/market_npc_trades"
        },
        {
          "do": "tag",
          "tag": "cirrus:quality/junk"
        }
      ]
    },
    {
      "id": "cirrus:machine_produce_displays",
      "label": "[feat+dispose] Industrial Foregoing machine produce preview",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "contains",
        "values": [
          "industrialforegoing/machine_produce"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/machine_produce_displays"
        },
        {
          "do": "tag",
          "tag": "cirrus:quality/junk"
        }
      ]
    },
    {
      "id": "cirrus:synthetic_anvil_duplicates",
      "label": "[feat] Anvil display with per-enchantment-level duplicates",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "all_of",
        "conditions": [
          {
            "kind": "any_of",
            "conditions": [
              {
                "kind": "system",
                "op": "contains",
                "values": [
                  "category/minecraft/anvil"
                ]
              },
              {
                "kind": "system",
                "op": "in",
                "values": [
                  "minecraft:anvil",
                  "crafting_on_a_stick:anvil"
                ]
              }
            ]
          },
          {
            "kind": "recipe_id",
            "op": "regex",
            "values": [
              "enchantment\\._\\d+"
            ]
          }
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/synthetic_anvil_duplicates"
        }
      ]
    },
    {
      "id": "cirrus:anvil_system_recipes",
      "label": "[feat+dispose] The vanilla anvil system itself",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "in",
        "values": [
          "minecraft:anvil"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/anvil_system_recipes"
        },
        {
          "do": "tag",
          "tag": "cirrus:quality/junk"
        }
      ]
    },
    {
      "id": "cirrus:breeding_displays",
      "label": "[feat+dispose] Easy Villagers / Just Enough Breeding previews",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "prefix",
        "values": [
          "jei:category/easy_villagers/",
          "jei:category/justenoughbreeding/",
          "cirrus_test:jei__category/easy_villagers/",
          "cirrus_test:jei__category/justenoughbreeding/"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/breeding_displays"
        },
        {
          "do": "tag",
          "tag": "cirrus:quality/junk"
        }
      ]
    },
    {
      "id": "cirrus:loot_displays",
      "label": "[feat+dispose] Loot fabricator / sim chamber / structure-locate displays",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "contains",
        "values": [
          "hostilenetworks/loot_fabricator",
          "hostilenetworks/sim_chamber",
          "/loot_table",
          "/loot_fabricator",
          "locate_structure"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/loot_displays"
        },
        {
          "do": "tag",
          "tag": "cirrus:quality/junk"
        }
      ]
    },
    {
      "id": "cirrus:colony_views",
      "label": "[feat] MineColonies teachable recipe views（处置由 structural/colony_view_mirror 按是否镜像决定）",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "prefix",
        "values": [
          "jei:category/minecolonies/",
          "cirrus_test:jei__category/minecolonies/"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/colony_views"
        }
      ]
    },
    {
      "id": "cirrus:jei_vanilla_mirrors",
      "label": "[feat] JEI mirrors of vanilla systems",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "in",
        "values": [
          "jei:category/minecraft/crafting",
          "jei:category/minecraft/smelting",
          "jei:category/minecraft/blasting",
          "jei:category/minecraft/smoking",
          "jei:category/minecraft/campfire_cooking",
          "jei:category/minecraft/stonecutting",
          "jei:category/minecraft/smithing",
          "jei:category/minecraft/brewing"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/jei_vanilla_mirrors"
        }
      ]
    },
    {
      "id": "cirrus:recolor_systems",
      "label": "[feat] Recoloring machine systems",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "suffix",
        "values": [
          "/coloring",
          "/painting",
          "/dyer"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/recolor_systems"
        }
      ]
    },
    {
      "id": "cirrus:recolor_recipes",
      "label": "[feat] Redye/redye recipe ids",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "recipe_id",
        "op": "contains",
        "values": [
          "redying",
          "recolor",
          "redye"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/recolor_recipes"
        }
      ]
    },
    {
      "id": "cirrus:chisel_systems",
      "label": "[feat] Chisel/chipped block-swap systems",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "any_of",
        "conditions": [
          {
            "kind": "system",
            "op": "contains",
            "values": [
              "/chiseling"
            ]
          },
          {
            "kind": "system",
            "op": "prefix",
            "values": [
              "jei:category/chipped/",
              "cirrus_test:jei__category/chipped/"
            ]
          },
          {
            "kind": "system",
            "op": "suffix",
            "values": [
              "/mystery_conversion"
            ]
          }
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/chisel_systems"
        }
      ]
    },
    {
      "id": "cirrus:reinforced_swaps",
      "label": "[feat] SecurityCraft vanilla <-> reinforced swaps",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "contains",
        "values": [
          "securitycraft/vanilla_to_securitycraft",
          "securitycraft/securitycraft_to_vanilla"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/reinforced_swaps"
        }
      ]
    },
    {
      "id": "cirrus:recycling_recipes",
      "label": "[feat] Recycling/salvage/uncrafting recipe ids",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "recipe_id",
        "op": "regex",
        "values": [
          "(^|/|_)(recycling|recycle|salvage|salvaging|disassembly|disassembling|uncrafting|uncraft)(/|_|:|$)|nugget_from_smelting|clay_oven_bottom_to_clay"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/recycling_recipes"
        }
      ]
    },
    {
      "id": "cirrus:recycling_systems",
      "label": "[feat] Salvaging/scrapping/disassembly systems",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "any_of",
        "conditions": [
          {
            "kind": "system",
            "op": "suffix",
            "values": [
              "/salvaging",
              "/scrapping"
            ]
          },
          {
            "kind": "system",
            "op": "contains",
            "values": [
              "/disassembly"
            ]
          }
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/recycling_systems"
        }
      ]
    },
    {
      "id": "cirrus:mass_valorization",
      "label": "[feat] Composters and mass-valorization machines",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "contains",
        "values": [
          "composter",
          "composting",
          "nutritional_liquifier",
          "canning_machine"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/mass_valorization"
        }
      ]
    },
    {
      "id": "cirrus:resource_generators",
      "label": "[feat] Resource generators: cobblegen, drills, quarries",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "system",
        "op": "contains",
        "values": [
          "blockgen",
          "cobblegen",
          "laser_ore",
          "laser_drill",
          "ore_to_resource",
          "/quarry",
          "oil_drilling",
          "pollination",
          "/fruiting",
          "botanypots/crop",
          "alakarkinos",
          "graphite_processing",
          "occultism:miner",
          "nucleosynthesizing"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/resource_generators"
        }
      ]
    },
    {
      "id": "cirrus:living_matter_predictions",
      "label": "[feat] Living-matter / prediction pseudo-recipes",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "recipe_id",
        "op": "regex",
        "values": [
          "(^|[:/_])living_?matter([/_]|$)|_prediction$|/predictions?/"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/living_matter_predictions"
        }
      ]
    },
    {
      "id": "cirrus:giant_block_conversions",
      "label": "[feat] Giant block <-> item conversions",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "recipe_id",
        "op": "regex",
        "values": [
          "(^|/)giant_\\w+_to_"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/giant_block_conversions"
        }
      ]
    },
    {
      "id": "cirrus:anvil_leak_recipes",
      "label": "[feat] Anvil self-repair / enchantment pseudo-recipes（crafting_on_a_stick:anvil 是真实配方，已移除误杀；其泄漏条目由 anvil_system_recipes 按系统兜底）",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "recipe_id",
        "op": "regex",
        "values": [
          "^minecraft:anvil\\.(self_repair|materials_repair)|^minecraft:enchantment\\.|enchantment\\.lvl_\\d+"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/anvil_leak_recipes"
        }
      ]
    },
    {
      "id": "cirrus:storage_compression_shape",
      "label": "[feat] Storage ladder by shape: 9+:1 or 1:9 round-trips",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "any_of",
        "conditions": [
          {
            "kind": "all_of",
            "conditions": [
              {
                "kind": "slot_count",
                "channel": "input",
                "op": "eq",
                "value": 1
              },
              {
                "kind": "slot_count",
                "channel": "output",
                "op": "eq",
                "value": 1
              },
              {
                "kind": "material",
                "channel": "input",
                "amount": {
                  "op": "ge",
                  "value": 9
                }
              }
            ]
          },
          {
            "kind": "all_of",
            "conditions": [
              {
                "kind": "slot_count",
                "channel": "input",
                "op": "eq",
                "value": 1
              },
              {
                "kind": "slot_count",
                "channel": "output",
                "op": "eq",
                "value": 1
              },
              {
                "kind": "material",
                "channel": "output",
                "amount": {
                  "op": "ge",
                  "value": 9
                }
              }
            ]
          }
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/storage_compression_shape"
        }
      ]
    },
    {
      "id": "cirrus:storage_compression_families",
      "label": "[feat] Mod compression families beyond the 9:1 shape",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "any_of",
        "conditions": [
          {
            "kind": "recipe_id",
            "op": "prefix",
            "values": [
              "allthecompressed:compress/",
              "allthecompressed:decompress/",
              "create_compressed:"
            ]
          },
          {
            "kind": "recipe_id",
            "op": "suffix",
            "values": [
              "_from_crate",
              "_from_bag",
              "_from_conversion",
              "_block_craft",
              "_block_decraft"
            ]
          },
          {
            "kind": "recipe_id",
            "op": "contains",
            "values": [
              "storage_blocks/from_",
              "deconstruction",
              "9x9"
            ]
          }
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/storage_compression_families"
        }
      ]
    },
    {
      "id": "cirrus:variant_stonecutting_cycles",
      "label": "[feat] Decoration-mod stonecutting/shard variant cycles",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "all_of",
        "conditions": [
          {
            "kind": "recipe_mod",
            "op": "in",
            "values": [
              "createdeco",
              "dndecor",
              "garnished",
              "blockbox",
              "glazedresymmetry"
            ]
          },
          {
            "kind": "recipe_id",
            "op": "contains",
            "values": [
              "stonecutting",
              "shard",
              "slab",
              "pillar",
              "centered"
            ]
          }
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/variant_stonecutting_cycles"
        }
      ]
    },
    {
      "id": "cirrus:smithing_trim_swaps",
      "label": "[feat] Smithing trim swaps",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "recipe_id",
        "op": "suffix",
        "values": [
          "_smithing_trim"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/smithing_trim_swaps"
        }
      ]
    },
    {
      "id": "cirrus:slab_to_block_generalized",
      "label": "[feat] Quark generalized slab-to-block recipes",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "recipe_id",
        "op": "prefix",
        "values": [
          "quark:tweaks/crafting/slab_to_block"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/slab_to_block_generalized"
        }
      ]
    },
    {
      "id": "cirrus:chisel_stonecutting_variants",
      "label": "[feat] Chipped/chisel stonecutting variants",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "recipe_id",
        "op": "contains",
        "values": [
          "stonecutting/chipped_",
          "stonecutting/chisel_"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/chisel_stonecutting_variants"
        }
      ]
    },
    {
      "id": "cirrus:salvage_mod_roundtrips",
      "label": "[feat] Create Salvage mod round-trips",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "recipe_mod",
        "op": "in",
        "values": [
          "create_salvage"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/salvage_mod_roundtrips"
        }
      ]
    },
    {
      "id": "cirrus:cobble_generators",
      "label": "[feat] Cobblestone/resource generator recipes",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "recipe_id",
        "op": "contains",
        "values": [
          "create_generators:generator_",
          "cobble_generator",
          "cobblestone_gen",
          "lava_from_cobble"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/cobble_generators"
        }
      ]
    },
    {
      "id": "cirrus:shape_reverse_roundtrips",
      "label": "[feat] Unpacking stairs/walls/slabs back into blocks",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "recipe_id",
        "op": "suffix",
        "values": [
          "_from_stairs",
          "_from_stair",
          "_from_walls",
          "_from_wall",
          "_from_slabs",
          "_from_slab"
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:feat/shape_reverse_roundtrips"
        }
      ]
    },
    {
      "id": "cirrus:relation/recolor",
      "label": "[relation] 换色特征 => pattern/recolor + discouraged",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "any_of",
        "conditions": [
          {
            "kind": "classification_tag",
            "tag": "cirrus:feat/recolor_systems"
          },
          {
            "kind": "classification_tag",
            "tag": "cirrus:feat/recolor_recipes"
          }
        ]
      },
      "then": [
        {
          "do": "tag",
          "tag": "cirrus:pattern/recolor"
        },
        {
          "do": "hint",
          "policy": "discouraged"
        }
      ]
    },
    {
      "id": "cirrus:relation/exchange",
      "label": "[relation] 变体互换特征 => pattern/exchange + discouraged",
      "stage": "catalog",
      "enabled": true,
      "when": {
        "kind": "any_of",
        "conditions": [
